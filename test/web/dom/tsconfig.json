{
  // View tests that drive DOM-typed modules (live mode) with fakes in Node: the root config plus the
  // DOM lib, as test/render does. `npm run typecheck` checks it; the root config excludes it.
  "extends": "../../../tsconfig.json",
  "compilerOptions": { "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node"] },
  "include": ["**/*.ts"],
  "exclude": []
}
