{
  // visual-proof's tools: compiled by scripts/vp.sh into a temp dir on every run (never into the repo),
  // and type-checked by `npm run typecheck`. rootDir is the repo, since scenes use web/src and the fixtures.
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../../..",
    "outDir": "dist",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "declaration": false,
    "sourceMap": false
  },
  "include": ["scripts/**/*.ts", "scenes/**/*.ts"],
  "exclude": []
}
